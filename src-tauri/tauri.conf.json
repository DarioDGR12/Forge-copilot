{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forge Copilot",
  "version": "0.1.0",
  "identifier": "com.forge.copilot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Forge Copilot",
        "width": 440,
        "height": 860,
        "minWidth": 380,
        "minHeight": 520,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "transparent": false,
        "visible": true,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Copilot local para Pop!_OS",
    "longDescription": "Overlay de chat con BYOK, terminal, archivos, capturas y Computer Use lite. Las acciones peligrosas piden confirmación. Sin backend propio.",
    "copyright": "Unlicense",
    "homepage": "https://github.com/DarioDGR12/Forge-copilot",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
